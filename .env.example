# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
#
# .env is gitignored, so this file is the tracked half of the pair: it tells a
# cloner which variables the stack wants without ever holding a real value.
# Compose loads .env from the directory holding the compose file automatically
# -- no --env-file flag needed.

# Grafana admin password. GF_SECURITY_ADMIN_PASSWORD defaults to "admin" if this
# is unset, and Grafana is published on 3000 to the LAN, so set it.
# Generate one:  openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# OpenElectricity (formerly OpenNEM) API key. The platform name is easy to get
# wrong and the legacy host is dead: register at platform.openelectricity.org.au,
# and the API is at api.openelectricity.org.au. The free Community plan is
# non-commercial, 2 years of history, 500 credits/day.
# Every /data, /facilities and /market endpoint requires it as a bearer token --
# there is no anonymous access, /v1/plans and /v4/social being the only exceptions.
#
# Read by battery-exporter. Compose fails to start that service without it --
# the `:?` in docker-compose.yml is deliberate, because an exporter that comes
# up with no key looks healthy and then reports nothing.
#
# The plan's *rate* limits bite before the credit allowance: 8 requests/5min,
# 32/hour, 366/day. The exporter polls hourly over 12 batteries, which is 13
# requests a cycle (14 on the daily fleet-metadata refresh) and 313 a day, so
# leave this budget alone unless you also raise --top in docker-compose.yml.
# Each request returns both stored energy and charge/discharge power, so the
# second metric costs nothing. The idle rotation does not change the total: it
# refills an empty slot from the next-largest candidate rather than adding one.
# Only --watchlist-per-cycle adds requests.
OPENEA_API_KEY=
