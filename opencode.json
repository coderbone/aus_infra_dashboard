{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "grafana": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "-e",
        "GRAFANA_URL=http://localhost:3000",
        "-e",
        "GRAFANA_ORG_ID=1",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana",
        "-t",
        "stdio"
      ],
      "environment": {
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{file:./.grafana-mcp-token}"
      },
      "enabled": true
    }
  }
}
