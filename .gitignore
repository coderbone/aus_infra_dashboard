*/__pycache__/

# Secrets. .env holds the OpenElectricity API key (OPENEA_API_KEY) and the
# Grafana admin password (GRAFANA_ADMIN_PASSWORD). .env.example is the tracked
# template, so it has to be un-ignored -- and the negation has to come after
# .env.*, which would otherwise match it.
.env
.env.*
!.env.example

# Grafana service-account token for the opencode MCP server (see opencode.json).
.grafana-mcp-token
